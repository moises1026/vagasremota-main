rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        resource.data.companyId == get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.id;
    }

    // Applications collection
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.companyId == 
          get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.id
      );
      allow create: if isAuthenticated() && 
        request.resource.data.candidateId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.companyId == 
          get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.id
      );
      allow delete: if isAuthenticated() && 
        resource.data.candidateId == request.auth.uid;
    }

    // Candidate profiles collection
    match /candidateProfiles/{profileId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Companies collection
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && 
        resource.data.companyId == get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.id;
      allow create: if isAuthenticated() && 
        request.resource.data.companyId == get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.id;
      allow update, delete: if isAuthenticated() && 
        resource.data.companyId == get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.id;
    }
  }
} 